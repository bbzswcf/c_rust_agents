pub fn arraylist_enlarge(arraylist: &mut ArrayList) -> i32 {
    let newsize = arraylist._alloced * 2;
    let data = unsafe {
        std::alloc::realloc(
            arraylist.data as *mut ArrayListValue,
            std::mem::size_of::<ArrayListValue>() * arraylist._alloced,
            std::mem::size_of::<ArrayListValue>() * newsize,
        )
    };

    if data.is_null() {
        return 0;
    } else {
        arraylist.data = data as *mut ArrayListValue;
        arraylist._alloced = newsize;
        return 1;
    }
}
