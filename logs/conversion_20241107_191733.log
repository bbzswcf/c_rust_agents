pub fn arraylist_new(length: usize) -> Option<Box<ArrayList>> {
    // Modified: Changed the comparison to `length == 0` to correctly handle the case where `length` is zero
    let length = if length == 0 { 16 } else { length };

    // Modified: Ensure the conversion from `usize` to `u32` is safe and does not truncate the value
    let _alloced = if length > u32::MAX as usize {
        u32::MAX
    } else {
        length as u32
    };

    let new_arraylist = Box::new(ArrayList {
        _alloced,
        length: 0,
        data: Vec::with_capacity(length),
    });

    Some(new_arraylist)
}
pub fn arraylist_free(arraylist: &mut Option<ArrayList>) {
    if let Some(al) = arraylist.take() {
        // Removed: Avoid explicit drop of `al.data` to prevent partial moves
        // Instead, rely on Rust's automatic drop mechanism
        // drop(al.data);
        // Then drop `al`
        drop(al);
    }
}
pub fn arraylist_enlarge(arraylist: &mut ArrayList) -> i32 {
    let newsize = arraylist._alloced * 2;

    // Create a Layout object for the current allocation size
    let layout = unsafe {
        std::alloc::Layout::from_size_align_unchecked(
            std::mem::size_of::<ArrayListValue>() * arraylist._alloced as usize,
            std::mem::align_of::<ArrayListValue>(),
        )
    };

    // Reallocate memory with the new size
    // Modified: Extract the raw pointer from `arraylist.data` and cast it to `*mut u8`
    let data = unsafe {
        std::alloc::realloc(
            arraylist.data.as_mut_ptr() as *mut u8,
            layout,
            std::mem::size_of::<ArrayListValue>() * newsize as usize,
        )
    };

    if data.is_null() {
        return 0;
    } else {
        // Modified: Wrap the call to `Vec::from_raw_parts` in an `unsafe` block
        // to indicate that you are aware of the potential undefined behavior and are taking responsibility for it.
        unsafe {
            arraylist.data = Vec::from_raw_parts(data as *mut *mut (), arraylist._alloced as usize, newsize as usize);
        }
        arraylist._alloced = newsize;
        return 1;
    }
}
