pub fn arraylist_insert(arraylist: &mut ArrayList, index: usize, data: ArrayListValue) -> i32 {
    // Sanity check the index
    // Convert `arraylist.length` to `usize` to match the type of `index`
    if index > arraylist.length.try_into().unwrap() {
        return 0;
