        pair = unsafe { hash_table_iter_next(&mut iterator) };
        val = pair.value as *mut libc::c_char;

        if unsafe { atoi(val) } % 100 == 0 {
            
            unsafe {
                hash_table_remove(hash_table, val as HashTableKey);
