pub extern "C" fn rb_tree_new(
    mut compare_func: RBTreeCompareFunc,
) -> *mut RBTree {
    let mut new_tree: *mut RBTree = std::ptr::null_mut();

    
    unsafe {
        new_tree = alloc_test_malloc(std::mem::size_of::<RBTree>() as libc::c_ulong)
            as *mut RBTree;
    }

    if new_tree.is_null() {
        return std::ptr::null_mut();
    }

    
    unsafe {
        (*new_tree).root_node = std::ptr::null_mut();
        (*new_tree).num_nodes = 0;
        (*new_tree).compare_func = compare_func;
    }

    new_tree
}
