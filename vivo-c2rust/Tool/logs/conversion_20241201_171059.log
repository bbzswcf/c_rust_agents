2024-12-01 17:17:01 - INFO - pub extern "C" fn avl_tree_insert(
    mut tree: *mut AVLTree,
    mut key: AVLTreeKey,
    mut value: AVLTreeValue,
) -> *mut AVLTreeNode {
    let mut rover: *mut *mut AVLTreeNode = std::ptr::null_mut();
    let mut new_node: *mut AVLTreeNode = std::ptr::null_mut();
    let mut previous_node: *mut AVLTreeNode = std::ptr::null_mut();

    let boxed_tree = unsafe { Box::from_raw(tree) };
    rover = &mut boxed_tree.root_node;
    previous_node = std::ptr::null_mut();

    while !(*rover).is_null() {
        previous_node = *rover;
        if (boxed_tree.compare_func).expect("non-null function pointer")(key, (**rover).key) < 0 {
            rover = &mut *((**rover).children)
                .as_mut_ptr()
                .offset(AVL_TREE_NODE_LEFT as isize)
                as *mut *mut AVLTreeNode;
        } else {
            rover = &mut *((**rover).children)
                .as_mut_ptr()
                .offset(AVL_TREE_NODE_RIGHT as isize)
                as *mut *mut AVLTreeNode;
        }
    }

    new_node = alloc_test_malloc(std::mem::size_of::<AVLTreeNode>() as libc::c_ulong)
        as *mut AVLTreeNode;

    if new_node.is_null() {
        tree = Box::into_raw(boxed_tree);
        return std::ptr::null_mut();
    }

    let boxed_new_node = unsafe { Box::from_raw(new_node) };
    boxed_new_node.children[AVL_TREE_NODE_LEFT as usize] = std::ptr::null_mut();
    boxed_new_node.children[AVL_TREE_NODE_RIGHT as usize] = std::ptr::null_mut();
    boxed_new_node.parent = previous_node;
    boxed_new_node.key = key;
    boxed_new_node.value = value;
    boxed_new_node.height = 1;
    *rover = Box::into_raw(boxed_new_node);
    avl_tree_balance_to_root(tree, previous_node);
    boxed_tree.num_nodes = boxed_tree.num_nodes.wrapping_add(1);
    tree = Box::into_raw(boxed_tree);

    new_node
}
