            >(Some(int_compare)),
        );
    }

    i = 0;
    while i < num_entries {
        unsafe {
            avl_tree_insert(
                tree,
                &mut *entries.as_mut_ptr().offset(i as isize) as *mut libc::c_int as AVLTreeKey,
                std::ptr::null_mut(),
            );
        }
        i = i.wrapping_add(1);
    }

    assert_eq!(unsafe { avl_tree_num_entries(tree) }, num_entries);

    unsafe {
        array = avl_tree_to_array(tree) as *mut *mut libc::c_int;
    }

    i = 0;
    while i < num_entries {
        assert_eq!(unsafe { *(*array.offset(i as isize)) }, sorted[i as usize]);
        i = i.wrapping_add(1);
    }

    unsafe {
        alloc_test_free(array as *mut libc::c_void);
        avl_tree_free(tree);
    }
}
