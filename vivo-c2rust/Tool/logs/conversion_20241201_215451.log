    assert_eq!(count, 10000, "count == NUM_TEST_VALUES");
    assert_eq!(
        unsafe { hash_table_num_entries(hash_table) },
        (10000 as libc::c_uint).wrapping_sub(removed),
        "hash_table_num_entries(hash_table) == NUM_TEST_VALUES - removed"
