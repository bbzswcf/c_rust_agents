                !unsafe { hash_table_lookup(hash_table, buf.as_mut_ptr() as HashTableKey) }.is_null(),
                "hash_table_lookup(hash_table, buf) != NULL"
            );
        }
        i += 1;
    }

    
    unsafe {
        hash_table_free(hash_table);
    }
}
