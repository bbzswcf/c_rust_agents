pub extern "C" fn test_avl_tree_child() {
    let mut tree: *mut AVLTree = std::ptr::null_mut();
    let mut root: *mut AVLTreeNode = std::ptr::null_mut();
    let mut left: *mut AVLTreeNode = std::ptr::null_mut();
    let mut right: *mut AVLTreeNode = std::ptr::null_mut();
    let mut values: [libc::c_int; 3] = [1, 2, 3];
    let mut p: *mut libc::c_int = std::ptr::null_mut();
    let mut i: libc::c_int = 0;

    
    unsafe {
        tree = avl_tree_new(
            std::mem::transmute::<
                Option<unsafe extern "C" fn(*mut libc::c_void, *mut libc::c_void) -> libc::c_int>,
                AVLTreeCompareFunc,
            >(Some(int_compare)),
        );
    }

    i = 0;
    while i < 3 {
        
        unsafe {
            avl_tree_insert(
                tree,
                &mut *values.as_mut_ptr().offset(i as isize) as *mut libc::c_int as AVLTreeKey,
                &mut *values.as_mut_ptr().offset(i as isize) as *mut libc::c_int as AVLTreeValue,
            );
        }
        i += 1;
    }

    
    unsafe {
        root = avl_tree_root_node(tree);
        p = avl_tree_node_value(root) as *mut libc::c_int;
        assert!(*p == 2, "Expected *p to be 2");

        left = avl_tree_node_child(root, AVL_TREE_NODE_LEFT);
        p = avl_tree_node_value(left) as *mut libc::c_int;
        assert!(*p == 1, "Expected *p to be 1");

        right = avl_tree_node_child(root, AVL_TREE_NODE_RIGHT);
        p = avl_tree_node_value(right) as *mut libc::c_int;
        assert!(*p == 3, "Expected *p to be 3");

        assert!(avl_tree_node_child(root, 10000).is_null(), "Expected avl_tree_node_child(root, 10000) to be NULL");
        assert!(avl_tree_node_child(root, 2).is_null(), "Expected avl_tree_node_child(root, 2) to be NULL");

        avl_tree_free(tree);
    }
}
```
