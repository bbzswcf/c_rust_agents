    let mut i: libc::c_int = 0;
    tree = avl_tree_new(
        ::core::mem::transmute::<
            Option::<
                unsafe extern "C" fn(*mut libc::c_void, *mut libc::c_void) -> libc::c_int,
            >,
            AVLTreeCompareFunc,
