    mut string1: *mut libc::c_void,
    mut string2: *mut libc::c_void,
) -> libc::c_int {
    let mut p1: *mut libc::c_char = string1 as *mut libc::c_char;
    let mut p2: *mut libc::c_char = string2 as *mut libc::c_char;
    let mut c1: libc::c_int = 0;
